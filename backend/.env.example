# DATABASE
# For Supabase serverless, use the connection pooler URL (port 6543)
DATABASE_URL=postgresql://user:password@db.project.supabase.co:5432/postgres

# SUPABASE (Backend requires both for Admin / Storage APIs)
SUPABASE_URL=your_supabase_project_url
SUPABASE_SECRET_KEY=your_supabase_service_role_key

# VERCEL CRON
CRON_SECRET=generate-a-secure-random-string

# OTHER INTEGRATIONS
PORT=4000
JWT_SECRET=generate-a-long-random-string-for-state
