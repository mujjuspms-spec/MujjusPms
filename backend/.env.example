# DATABASE
# Runtime connection: MUST use Supabase's connection pooler (port 6543,
# with ?pgbouncer=true) — the app runs as Vercel serverless functions,
# and each instance opens its own connection pool (see lib/prisma.js).
# Pointing this at the direct connection (port 5432) instead exhausts
# Supabase's connection limit under load and requests just hang.
DATABASE_URL=postgresql://user:password@db.project.supabase.co:6543/postgres?pgbouncer=true

# Migrations only (prisma migrate): the pooler doesn't support the DDL
# `prisma migrate` needs, so this must stay the direct connection.
DIRECT_URL=postgresql://user:password@db.project.supabase.co:5432/postgres

# SUPABASE (Backend requires both for Admin / Storage APIs)
SUPABASE_URL=your_supabase_project_url
SUPABASE_SECRET_KEY=your_supabase_service_role_key

# VERCEL CRON
CRON_SECRET=generate-a-secure-random-string

# OTHER INTEGRATIONS
PORT=4000
JWT_SECRET=generate-a-long-random-string-for-state
# SERPER_API_KEY=your_serper_api_key
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SLACK_SIGNING_SECRET=
# SLACK_BOT_TOKEN=
